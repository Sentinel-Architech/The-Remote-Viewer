#!/data/data/com.termux/files/usr/bin/bash
# After merge/pull: ensure automation scripts are executable
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
chmod +x "$ROOT"/scripts/*.sh 2>/dev/null || true
chmod +x "$ROOT"/scripts/hooks/* 2>/dev/null || true
chmod +x "$ROOT"/modules/*/\*.sh 2>/dev/null || true
# broader module scripts
find "$ROOT/modules" -name '*.sh' -type f -exec chmod +x {} + 2>/dev/null || true
echo "[hooks] post-merge: script modes refreshed"
