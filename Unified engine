#[derive(Debug, Copy, Clone, PartialEq)]
pub enum HardwareTier {
    ConstrainedFeaturePhone, // SMS / Audio AFSK / DTMF Burst
    StandardMobileDevice,    // Native Rust Binary / P2P Mesh / GNSS
    HighEndEnterpriseNode,   // Full Validator / Cluster / SDR
}

#[derive(ZeroizeOnDrop)]
pub struct SovereignEngine4x {
    node_seed: [u8; 32],
    session_secret: [u8; 32],
    sei_weights: [f32; 64],
    hardware_tier: HardwareTier,
    duress_active: bool,
}

impl SovereignEngine4x {
    pub fn boot(tier: HardwareTier) -> Self {
        let mut rng = OsRng;
        let mut seed = [0u8; 32];
        let mut session_secret = [0u8; 32];
        
        rng.fill_bytes(&mut seed);
        rng.fill_bytes(&mut session_secret);

        Self {
            node_seed: seed,
            session_secret,
            sei_weights: [0.5; 64],
            hardware_tier: tier,
            duress_active: false,
        }
    }

    pub fn derive_keypair(&self) -> Keypair {
        let mut seed_clone = self.node_seed;
        let secret = ed25519_dalek::SecretKey::from_bytes(&seed_clone).unwrap();
        let public = ed25519_dalek::PublicKey::from(&secret);
        seed_clone.zeroize();
        Keypair { secret, public }
    }

    pub fn encrypt_stream(&self, plaintext: &[u8]) -> Result<Vec<u8>, &'static str> {
        if self.duress_active {
            return Err("Critical: Node under duress or wiped. Operations halted.");
        }

        let cipher = XChaCha20Poly1305::new(&self.session_secret.into());
        let mut nonce = [0u8; 24];
        OsRng.fill_bytes(&mut nonce);
        let xnonce = XNonce::from_slice(&nonce);

        let ciphertext = cipher.encrypt(xnonce, plaintext).map_err(|_| "Encryption fault")?;
        let mut payload = Vec::with_capacity(24 + ciphertext.len());
        payload.extend_from_slice(&nonce);
        payload.extend_from_slice(&ciphertext);
        Ok(payload)
    }

    pub fn optimize_sei_matrix(&mut self, sensor_vector: &[f32; 4], threat_intercepted: bool) {
        if self.duress_active { return; }
        let adjustment = if threat_intercepted { 0.02 } else { -0.01 };
        
        for (i, weight) in self.sei_weights.iter_mut().enumerate() {
            let influence = sensor_vector[i % sensor_vector.len()];
            *weight = (*weight + (influence * adjustment)).clamp(0.0, 1.0);
        }
    }

    pub fn fractal_serialize(&self) -> Vec<u8> {
        match self.hardware_tier {
            HardwareTier::ConstrainedFeaturePhone => {
                let mut compressed = [0u8; 16];
                for (i, &weight) in self.sei_weights.iter().enumerate() {
                    compressed[i % 16] ^= (weight * 255.0) as u8;
                }
                compressed.to_vec()
            }
            _ => {
                let mut serialized = Vec::with_capacity(self.sei_weights.len() * 4);
                for w in &self.sei_weights {
                    serialized.extend_from_slice(&w.to_le_bytes());
                }
                serialized
            }
        }
    }

    pub fn execute_panic_wipe(&mut self) {
        self.node_seed.zeroize();
        self.session_secret.zeroize();
        self.sei_weights.zeroize();
        self.duress_active = true;
    }
}

#[cfg(test)]
mod sovereign_tests {
    use super::*;

    #[test]
    fn test_sovereign_boot_and_key_derivation() {
        let engine = SovereignEngine4x::boot(HardwareTier::StandardMobileDevice);
        let keypair = engine.derive_keypair();
        let msg = b"TRV_STATE_CHECK";
        let signature = keypair.sign(msg);
        assert!(keypair.public.verify(msg, &signature).is_ok());
    }

    #[test]
    fn test_xchacha20_stream_encryption() {
        let engine = SovereignEngine4x::boot(HardwareTier::StandardMobileDevice);
        let plaintext = b"Sovereign telemetry vector payload";
        let encrypted = engine.encrypt_stream(plaintext).expect("Encryption failed");
        assert!(encrypted.len() > 24);
        assert_ne!(&encrypted[24..], plaintext);
    }

    #[test]
    fn test_fractal_tier_serialization() {
        let phone_engine = SovereignEngine4x::boot(HardwareTier::ConstrainedFeaturePhone);
        let phone_payload = phone_engine.fractal_serialize();
        assert_eq!(phone_payload.len(), 16);

        let mobile_engine = SovereignEngine4x::boot(HardwareTier::StandardMobileDevice);
        let mobile_payload = mobile_engine.fractal_serialize();
        assert!(mobile_payload.len() > 16);
    }

    #[test]
    fn test_panic_wipe_protocol() {
        let mut engine = SovereignEngine4x::boot(HardwareTier::StandardMobileDevice);
        engine.execute_panic_wipe();
        let result = engine.encrypt_stream(b"test");
        assert!(result.is_err());
    }
}

