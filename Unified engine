    let socket = Arc::new(UdpSocket::bind("0.0.0.0:7890")?);
    socket.set_broadcast(true)?;
    socket.set_nonblocking(true)?;

    let s_clone = Arc::clone(&socket);
    tokio::spawn(async move {
        let broadcast_addr = "255.255.255.255:7890".parse().unwrap();
        let mut interval = time::interval(Duration::from_secs(3));
        loop {
            interval.tick().await;
            let _ = s_clone.send_to(b"TRV_SOVEREIGN_NODE_BEACON", &broadcast_addr);
        }
