    let mut buf = [0u8; 512];
    loop {
        if let Ok((amt, _src)) = socket.recv_from(&mut buf) {
            if amt > 0 {
                let mut locked_engine = engine.lock().await;
                locked_engine.optimize_sei_matrix(&[0.1, 0.5, 0.8, 0.2], true);
            }
