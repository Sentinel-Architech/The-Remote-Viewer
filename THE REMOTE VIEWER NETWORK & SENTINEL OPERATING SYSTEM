    pub fn run_server(self: Arc<Self>) -> Result<(), Box<dyn std::error::Error>> {
        self.bootstrap()?;
        let listener = TcpListener::bind(&self.bind_addr)?;
        println!("[+] Node active and listening securely on {}", self.bind_addr);
        println!("[+] Node ID: {:016X} | Zero-Trust Mesh Operational", self.node_id);

        for stream in listener.incoming() {
            match stream {
                Ok(mut client_stream) => {
                    let daemon = Arc::clone(&self);
                    thread::spawn(move || {
                        if let Err(e) = daemon.handle_client(&mut client_stream) {
                            eprintln!("[-] Session anomaly resolved: {}", e);
                        }
                    });
                }
                Err(e) => {
                    eprintln!("[-] Inbound transport drop: {}", e);
                }
            }
        }
        Ok(())
    }

    fn handle_client(&self, stream: &mut TcpStream) -> Result<(), Box<dyn std::error::Error>> {
        let mut buffer = [0u8; 2048];
        let bytes_read = stream.read(&mut buffer)?;
        if bytes_read == 0 {
            return Err("Empty transmission frame.".into());
        }

        let request = &buffer[..bytes_read];
        if request.len() < 16 || &request[..16] != b"SOVEREIGN_AUTH_V1" {
            stream.write_all(b"HTTP/1.1 403 Forbidden\r\nContent-Length: 23\r\n\r\nUnauthorized State Root")?;
            return Err("Unauthorized frame rejected.".into());
        }

        // Simulate ZKP & PQC validation assertion
        let proof = vec![0x01, 0x02];
        let pub_inputs = vec![0x00];
        if !ZeroKnowledgeVerifier::verify_proof(&proof, &pub_inputs)? {
            return Err("Zero-knowledge verification failure.".into());
        }

        let timestamp = SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs();
        let json_response = format!(
            "{{\"status\":\"operational\",\"node_id\":\"{:016X}\",\"timestamp\":{}}}",
            self.node_id, timestamp
        );

        let http_payload = format!(
            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
            json_response.len(),
            json_response
        );

        stream.write_all(http_payload.as_bytes())?;
        stream.flush()?;
        Ok(())
    }
}

