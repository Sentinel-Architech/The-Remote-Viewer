    }

    pub fn commit_state(&self, key: &str, data: &[u8]) -> Result<(), &'static str> {
        let path = Path::new(&self.path);
        if let Some(parent) = path.parent() {
            create_dir_all(parent).map_err(|_| "Failed to allocate storage root directory.")?;
        }
        let mut file = OpenOptions::new()
            .read(true)
            .write(true)
            .create(true)
            .open(path)
            .map_err(|_| "Storage stream allocation fault.")?;

        file.write_all(data).map_err(|_| "Storage write failure.")?;
        Ok(())
