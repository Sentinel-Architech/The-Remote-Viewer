// --- 3. DECENTRALIZED MESH ROUTING ENGINE ---

pub struct MeshPacket {
    pub source_node: u64,
    pub destination_node: u64,
    pub payload: Vec<u8>,
}

pub struct SecureMeshRouter {
    node_id: u64,
    routes: HashMap<u64, String>,
}

impl SecureMeshRouter {
    pub const fn new(node_id: u64) -> Self {
        Self {
            node_id,
            routes: HashMap::new(),
        }
    }

    pub fn register_route(&mut self, peer_id: u64, endpoint: String) {
        self.routes.insert(peer_id, endpoint);
    }

    pub fn encapsulate(&self, destination_node: u64, raw_data: &[u8]) -> Result<MeshPacket, &'static str> {
        if raw_data.is_empty() {
            return Err("Mesh encapsulation error: empty payload.");
        }
        let mut wrapped = Vec::with_capacity(raw_data.len() + 16);
        wrapped.extend(b"REMOTE_VIEWER_V1");
        wrapped.extend(raw_data);

        Ok(MeshPacket {
            source_node: self.node_id,
            destination_node,
            payload: wrapped,
        })
    }

    pub fn decapsulate(&self, packet: &MeshPacket) -> Result<Vec<u8>, &'static str> {
        if packet.destination_node != self.node_id {
            return Err("Routing failure: destination node mismatch.");
        }
        if packet.payload.len() < 16 || &packet.payload[..16] != b"REMOTE_VIEWER_V1" {
            return Err("Decapsulation failure: invalid cryptographic wrapper.");
        }
        Ok(packet.payload[16..].to_vec())
    }
}

