// crates/sentinel-node/tests/verify_creator.rs
// Sovereign Network Verification Suite: Validating Creator Node Integrity & Address Binding

#[cfg(test)]
mod tests {
    use std::io::{Read, Write};
    use std::net::TcpStream;

    #[test]
    fn test_creator_node_authentication() {
        // Test connection simulation against the active sovereign creator node socket
        let target = "127.0.0.1:9050";
        if let Ok(mut stream) = TcpStream::connect(target) {
            let auth_frame = b"SOVEREIGN_AUTH_V1_VERIFY";
            assert!(stream.write_all(auth_frame).is_ok());
            assert!(stream.flush().is_ok());

            let mut response = Vec::new();
            if stream.read_to_end(&mut response).is_ok() && !response.is_empty() {
                let response_str = String::from_utf8_lossy(&response);
                assert!(response_str.contains("Sentinel-Archetecht") || response_str.contains("sovereign_primary"));
                println!("[+] Creator Node Identity Verified Successfully.");
            }
        } else {
            println!("[*] Sovereign node daemon is offline. Start the service to execute live verification.");
        }
    }
}
