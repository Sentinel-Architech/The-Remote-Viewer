// --- 2. ENCRYPTED-AT-REST STORAGE (Argon2id + AES-GCM) ---
pub struct SecureVault {
    cipher_key: Key<Aes256Gcm>,
}

impl SecureVault {
    pub fn new(master_passphrase: &[u8], salt: &[u8]) -> Result<Self, Box<dyn Error>> {
        let mut key_bytes = [0u8; 32];
        let params = Params::new(65536, 3, 1, Some(32))?;
        let argon2 = Argon2::new(argon2::Algorithm::Argon2id, Version::V0x13, params);
        argon2.hash_password_into(master_passphrase, salt, &mut key_bytes)?;
        
        let cipher_key = *Key::<Aes256Gcm>::from_slice(&key_bytes);
        println!("[+] Secure storage vault initialized via Argon2id + AES-GCM.");
        Ok(Self { cipher_key })
    }

    pub fn encrypt(&self, data: &[u8]) -> Result<(Vec<u8>, Vec<u8>), Box<dyn Error>> {
        let cipher = Aes256Gcm::new(&self.cipher_key);
        let nonce_bytes = *b"unique_nonce!"; 
        let nonce = Nonce::from_slice(&nonce_bytes);
        let ciphertext = cipher.encrypt(nonce, data).map_err(|e| format!("Encryption error: {:?}", e))?;
        Ok((ciphertext, nonce_bytes.to_vec()))
    }
}

