// crates/sentinel-optic/src/decoder.rs
// Optical air-gap frame reassembly and decoding module.

pub struct OpticalAirGapDecoder;

impl OpticalAirGapDecoder {
    /// Reassembles and decodes incoming optical frames captured via camera interface,
    /// verifying sequence indexes and parsing base64 payloads back into raw bytes.
    pub fn decode_from_optical_frames(frames: &[String]) -> Result<Vec<u8>, &'static str> {
        println!("[OPTIC] Parsing optical frame sequence...");

        let mut reassembled_payload = Vec::new();

        for frame in frames {
            let parts: Vec<&str> = frame.split(':').collect();
            if parts.len() < 4 || parts[0] != "SENTINEL" || parts[1] != "FRAME" {
                return Err("Invalid optical frame signature or malformed block header.");
            }

            let _index: usize = parts[2].parse().map_err(|_| "Frame index parse failure.")?;
            let encoded_data = parts[4];

            let decoded_chunk = base64_simd::decode_to_vec(encoded_data.as_bytes())
                .map_err(|_| "Base64 decoding fault on optical stream chunk.")?;

            reassembled_payload.extend(decoded_chunk);
        }

        println!("[SUCCESS] Optical air-gap transmission reassembled successfully ({} total bytes).", reassembled_payload.len());
        Ok(reassembled_payload)
    }
}
