pub struct SovereignStorage {
    path: String,
}

impl SovereignStorage {
    pub const fn new(path: String) -> Self {
        Self { path }
    }

    pub fn verify_health(&self) -> Result<(), &'static str> {
        let path = Path::new(&self.path);
        if let Some(parent) = path.parent() {
            if !parent.exists() {
                std::fs::create_dir_all(parent).map_err(|_| "Failed to allocate storage directory.")?;
            }
        }
        let mut file = OpenOptions::new()
            .read(true)
            .write(true)
            .create(true)
            .open(path)
            .map_err(|_| "Storage block I/O failure.")?;
        
        file.write_all(b"SOVEREIGN_STORAGE_OK").map_err(|_| "Storage write failure.")?;
        Ok(())
    }
}

pub struct NodeTelemetryLogger {
    node_id: u64,
}

impl NodeTelemetryLogger {
    pub const fn new(node_id: u64) -> Self {
        Self { node_id }
    }

    pub fn generate_audit_record(&self, event_type: &str, status_code: u16) -> Result<Vec<u8>, &'static str> {
        let timestamp = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map_err(|_| "System time divergence error.")?
            .as_secs();

        let mut record = Vec::with_capacity(64);
        record.extend(&self.node_id.to_le_bytes());
        record.extend(&timestamp.to_le_bytes());
        record.extend(&status_code.to_le_bytes());
        record.extend(event_type.as_bytes());
        Ok(record)
    }
}

