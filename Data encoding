// crates/sentinel-optic/src/lib.rs
// Splits a payload into chunks. This function does not open an air gap.

pub struct OpticalAirGapEncoder {
    chunk_size: usize,
    redundancy_factor: f32,
}

impl OpticalAirGapEncoder {
    pub const fn new(chunk_size: usize) -> Self {
        Self {
            chunk_size,
            redundancy_factor: 1.5,
        }
    }

    pub fn encode_payload(&self, payload: &[u8]) -> Result<Vec<Vec<u8>>, &'static str> {
        if payload.is_empty() {
            return Err("Payload cannot be empty.");
        }

        let mut frames = Vec::new();
        let total_chunks = (payload.len() + self.chunk_size - 1) / self.chunk_size;

        for (i, chunk) in payload.chunks(self.chunk_size).enumerate() {
            let mut frame = Vec::with_capacity(chunk.len() + 6);
            // Frame header: [sequence_id (u32), total_chunks (u16)]
            frame.extend(&(i as u32).to_le_bytes());
            frame.extend(&(total_chunks as u16).to_le_bytes());
            frame.extend(chunk);
            frames.push(frame);
        }

        Ok(frames)
    }
}
