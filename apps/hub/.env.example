# Optional. Neon / Postgres. Empty = in-process PGLite (WASM) for local/preview.
DATABASE_URL=

# Required in production. Signs Better Auth sessions.
BETTER_AUTH_SECRET=

# Optional. Billing rails. Hub runs without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional. Sentinel speak / xAI.
XAI_API_KEY=

# Set false only for a fully offline demo with no federated login.
# VITE_AUTH_ENABLED=true
