# Optional. Neon / Postgres. Empty = in-process PGLite (WASM) for local/preview.
DATABASE_URL=

# Required in production. Signs Better Auth sessions.
BETTER_AUTH_SECRET=

# Verified human comms Checkout ($10 USD / month, $50 USD / year).
# Restricted key (rk_) is preferred. Never commit the value.
# Without STRIPE_SECRET_KEY, Checkout does not open and the plan is not granted.
STRIPE_SECRET_KEY=
# Signing secret for POST https://the-remote-viewer.grok.me/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed
# Without this, a paid Checkout cannot grant Verified.
STRIPE_WEBHOOK_SECRET=
# Optional live Price ids. Leave empty to use lookup keys
# trv_human_comms_month ($10) and trv_human_comms_year ($50).
# A price with any other amount is refused. The $96 figure is retired.
STRIPE_PRICE_HUMAN_MONTH=
STRIPE_PRICE_HUMAN_YEAR=
# Unused by human-comms Checkout.
STRIPE_PRICE_ID=

# Optional. Sentinel speak / xAI.
XAI_API_KEY=

# Set false only for a fully offline demo with no federated login.
# VITE_AUTH_ENABLED=true

# Operator email when a new Viewer account is created. Both required to send.
OPERATOR_NOTIFY_EMAIL=
RESEND_API_KEY=
# Optional verified Resend from-address.
NOTIFY_FROM_EMAIL=
