{
  "name": "@trv/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "The Remote Viewer mobile client — SCAFFOLD ONLY. No security claims.",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
    "start:localhost": "expo start --localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "install:expo": "npx expo install --fix"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~2.2.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
