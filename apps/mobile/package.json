{
  "name": "@trv/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "The Remote Viewer mobile client — SCAFFOLD ONLY. No security claims.",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
    "start:localhost": "expo start --localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "install:expo": "npx expo install expo-crypto expo-secure-store expo-status-bar"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-crypto": "~13.0.2",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
