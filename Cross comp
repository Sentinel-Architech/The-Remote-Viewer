# .cargo/config.toml
# Cross-compilation target profile for ARM64 Android / GrapheneOS execution environments

[target.aarch64-linux-android]
linker = "rust-lld"
rustflags = [
    "-C", "target-cpu=native",
    "-C", "panic=abort",
    "-C", "relocation-model=pic",
    "-C", "strip=symbols",
    "-C", "lto=fat"
]

[alias]
build-mobile = "build --target aarch64-linux-android --release"
