            }
            CommsTier::Tier2HD | CommsTier::Tier3Pro => Ok(payload.to_vec()), // Crystal clear HD/Pro
        }
    }
    pub fn watermark(&self) -> &'static str { "🛡️ [THE SENTINEL EMBLEM // ACTIVE WATERMARK]" }
}

