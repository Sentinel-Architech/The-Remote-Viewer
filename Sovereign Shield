    peers: Arc<Mutex<HashMap<String, String>>>,
}

impl P2PMeshNode {
    pub fn new(node_id: String) -> Self {
        Self {
            node_id,
            peers: Arc::new(Mutex::new(HashMap::new())),
        }
    }

    pub fn register_peer(&self, peer_id: String, address: String) -> Result<(), &'static str> {
        let mut peer_map = self.peers.lock().map_err(|_| "Mesh Lock Poisoned: Concurrency fault.")?;
        peer_map.insert(peer_id.clone(), address);
        println!("[MESH] Peer [{}] integrated into node [{}] routing table.", peer_id, self.node_id);
        Ok(())
    }

    pub fn spawn_heartbeat(node_id: String) {
        thread::spawn(move || {
            println!("[MESH] Node [{}] online. 24/7 decentralized gossip active.", node_id);
            loop {
                thread::sleep(Duration::from_secs(60));
                println!("[MESH-SYNC] Global state accumulator broadcasted across peer network.");
            }
        });
    }
}

