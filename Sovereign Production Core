// ----------------------------------------------------------------------------
// 3. MESH STORE-AND-FORWARD ROUTING (tunnel/src/store_forward.rs)
// ----------------------------------------------------------------------------

pub struct MeshStoreAndForward {
    cache_ring: VecDeque<Vec<u8>>,
    max_capacity: usize,
}

impl MeshStoreAndForward {
    pub fn new(max_capacity: usize) -> Self {
        Self {
            cache_ring: VecDeque::with_capacity(max_capacity),
            max_capacity,
        }
    }

    pub fn buffer_payload(&mut self, payload: Vec<u8>) {
        if self.cache_ring.len() >= self.max_capacity {
            self.cache_ring.pop_front();
        }
        self.cache_ring.push_back(payload);
    }
}

