#[derive(Serialize, Deserialize, Clone)]
pub struct GlobalSovereignPacket {
    pub sender_id: [u8; 32],
    pub sex_at_birth: LegalSexAtBirth,
    pub payload: Vec<u8>,
    pub timestamp: u64,
    pub zkp_human_proof: [u8; 32],
}

pub struct GlobalDAppEngine {
    token_bucket: Arc<RwLock<u32>>,
    dag_chain: Arc<RwLock<Vec<GlobalSovereignPacket>>>,
}

impl GlobalDAppEngine {
    pub fn new() -> Self {
        Self {
            token_bucket: Arc::new(RwLock::new(1000)),
            dag_chain: Arc::new(RwLock::new(Vec::new())),
        }
    }

    pub async fn process_global_packet(
        &self,
        packet: GlobalSovereignPacket,
        liveness_verified: bool,
    ) -> Result<&'static str, &'static str> {
        if !liveness_verified {
            return Err("[Global Core]: Liveness and identity verification failed.");
        }

        let mut tokens = self.token_bucket.write().await;
        if *tokens == 0 {
            return Err("[Sybil Defense]: Rate limit exceeded. Token bucket empty.");
        }
        *tokens -= 1;
        drop(tokens);

        let mut chain = self.dag_chain.write().await;
        chain.push(packet);

        Ok("[Global Core]: Packet synchronized across decentralized mesh layers with zero latency.")
    }
}
