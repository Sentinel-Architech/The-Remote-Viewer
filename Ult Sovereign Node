# Architecture: QUIC-First + PQC (ML-KEM / ML-DSA) + Zero-Copy redb + Lock-Free Ringbuf
# ==============================================================================

set -euo pipefail

PROJECT_NAME="the-remote-viewer-core"
echo "[*] Initializing sovereign workspace directory: $PROJECT_NAME"
mkdir -p "$PROJECT_NAME/src"
cd "$PROJECT_NAME"

# 1. Write Hardened Cargo.toml Manifest
cat << 'EOF' > Cargo.toml
[package]
name = "the-remote-viewer-core"
version = "0.1.0"
edition = "2021"

[profile.release]
opt-level = 3
