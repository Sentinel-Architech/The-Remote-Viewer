use anchor_lang::prelude::*;
use anchor_spl::token_interface::{self, Mint, TokenAccount, TokenInterface, TransferChecked};

declare_id!("TokenStreaming22222222222222222222222222222222");

#[program]
pub mod token_streaming_enhanced {
    use super::*;

    pub fn stream_payment_batch(
        ctx: Context<StreamPaymentBatch>, 
        total_tokens: u64, 
        cost_per_token: u64,
        decimals: u8
    ) -> Result<()> {
        let escrow = &mut ctx.accounts.escrow;
        let total_cost = total_tokens.checked_mul(cost_per_token).ok_or(CustomError::Overflow)?;
        
        require!(escrow.balance >= total_cost, CustomError::InsufficientEscrowBalance);
        escrow.balance -= total_cost;

        let seeds = &[
            b"escrow",
            escrow.client.as_ref(),
            escrow.node.as_ref(),
            &[escrow.bump],
        ];
        let signer = &[&seeds[..]];

        let cpi_accounts = TransferChecked {
            from: ctx.accounts.escrow_vault.to_account_info(),
            mint: ctx.accounts.mint.to_account_info(),
            to: ctx.accounts.node_token_account.to_account_info(),
            authority: ctx.accounts.escrow.to_account_info(),
        };
        
        let cpi_program = ctx.accounts.token_program.to_account_info();
        token_interface::transfer_checked(
            CpiContext::new_with_signer(cpi_program, cpi_accounts, signer),
            total_cost,
            decimals,
        )?;

        Ok(())
    }
}

#[derive(Accounts)]
pub struct StreamPaymentBatch<'info> {
    #[account(
        mut,
        seeds = [b"escrow", escrow.client.as_ref(), escrow.node.as_ref()],
        bump = escrow.bump
    )]
    pub escrow: Account<'info, EscrowState>,
    pub mint: InterfaceAccount<'info, Mint>,
    #[account(
        mut,
        seeds = [b"vault", escrow.key().as_ref()],
        bump
    )]
    pub escrow_vault: InterfaceAccount<'info, TokenAccount>,
    #[account(mut)]
    pub node_token_account: InterfaceAccount<'info, TokenAccount>,
    pub token_program: Interface<'info, TokenInterface>,
    pub authority: Signer<'info>,
}

#[account]
pub struct EscrowState {
    pub client: Pubkey,
    pub node: Pubkey,
    pub balance: u64,
    pub bump: u8,
}

#[error_code]
pub enum CustomError {
    #[msg("Arithmetic overflow during batch cost calculation.")]
    Overflow,
    #[msg("Insufficient balance in escrow vault for batched token streaming.")]
    InsufficientEscrowBalance,
}


