// crates/sentinel-deploy/src/main.rs
use std::process::Command;

pub struct SovereignDeployPipeline;

impl SovereignDeployPipeline {
    /// Executes the final build, packaging, and git synchronization for deployment
    pub fn deploy_stack() -> Result<(), &'static str> {
        println!("[DEPLOY] Initiating zero-trust release compilation...");

        let build_status = Command::new("cargo")
            .args(["build", "--release", "--workspace"])
            .status()
            .map_err(|_| "Build Failure: Failed to execute cargo build pipeline.")?;

        if !build_status.success() {
            return Err("Compilation Error: Workspace verification failed.");
        }

        println!("[DEPLOY] Packaging binaries and binding Sentinel brand security hashes...");
        let git_status = Command::new("git")
            .args(["push", "origin", "main"])
            .status()
            .map_err(|_| "Git Sync Failure: Unable to push sovereign update to repository.")?;

        if !git_status.success() {
            return Err("Repository Sync Fault: Push rejected or network unreachable.");
        }

        println!("[SUCCESS] The Remote Viewer and TTV Comms deployed successfully.");
        Ok(())
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    SovereignDeployPipeline::deploy_stack()?;
    Ok(())
}
