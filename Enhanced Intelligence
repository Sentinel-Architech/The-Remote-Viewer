impl SovereignEngine4x {
    /// Bootstraps the 4x-enhanced sovereign node with absolute hardware entropy.
    pub fn boot(tier: HardwareTier) -> Self {
        let mut rng = OsRng;
        let mut seed = [0u8; 32];
        let mut session_secret = [0u8; 32];
        
        rng.fill_bytes(&mut seed);
        rng.fill_bytes(&mut session_secret);

        Self {
            node_seed: seed,
            session_secret,
            sei_weights: [0.5; 64],
            hardware_tier: tier,
            duress_active: false,
