                for (i, &weight) in self.sei_weights.iter().enumerate() {
                    compressed[i % 16] ^= (weight * 255.0) as u8;
                }
                compressed.to_vec()
            }
            _ => {
                // Full precision binary stream for high-tier mesh networks
                let mut serialized = Vec::with_capacity(self.sei_weights.len() * 4);
                for w in &self.sei_weights {
                    serialized.extend_from_slice(&w.to_le_bytes());
                }
                serialized
            }
        }
    }

    /// PANIC WIPE: Instantly zeroizes all cryptographic seeds, keys, and memory states.
