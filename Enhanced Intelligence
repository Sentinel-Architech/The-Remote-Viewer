    /// Derives the Ed25519 cryptographic keypair securely on-device.
    pub fn derive_keypair(&self) -> Keypair {
        let mut seed_clone = self.node_seed;
        let secret = ed25519_dalek::SecretKey::from_bytes(&seed_clone).unwrap();
        let public = ed25519_dalek::PublicKey::from(&secret);
        seed_clone.zeroize();
        Keypair { secret, public }
    }

    /// Encrypts operational streams using XChaCha20-Poly1305 AEAD with zero heap leakage.
    pub fn encrypt_stream(&self, plaintext: &[u8]) -> Result<Vec<u8>, &'static str> {
        if self.duress_active {
            return Err("Critical: Node under duress or wiped. Operations halted.");
        }

        let cipher = XChaCha20Poly1305::new(&self.session_secret.into());
        let mut nonce = [0u8; 24];
        OsRng.fill_bytes(&mut nonce);
        let xnonce = XNonce::from_slice(&nonce);

        let ciphertext = cipher.encrypt(xnonce, plaintext).map_err(|_| "Encryption fault")?;
        let mut payload = Vec::with_capacity(24 + ciphertext.len());
        payload.extend_from_slice(&nonce);
        payload.extend_from_slice(&ciphertext);
        Ok(payload)
    }

    /// Adapts SEI neural defense weights locally from real-world telemetry.
    pub fn optimize_sei_matrix(&mut self, sensor_vector: &[f32; 4], threat_intercepted: bool) {
        if self.duress_active { return; }
        let adjustment = if threat_intercepted { 0.02 } else { -0.01 };
        
        for (i, weight) in self.sei_weights.iter_mut().enumerate() {
            let influence = sensor_vector[i % sensor_vector.len()];
            *weight = (*weight + (influence * adjustment)).clamp(0.0, 1.0);
        }
    }

    /// Compresses and serializes operational state based on the hardware tier.
    pub fn fractal_serialize(&self) -> Vec<u8> {
